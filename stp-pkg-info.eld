;;; -*- buffer-read-only: t; no-byte-compile: t; -*-

((packages
  ("anaphora" (method . git)
   (remote . "https://github.com/rolandwalker/anaphora.git")
   (version . "v1.0.4") (update . stable))
  ("async" (method . git)
   (remote . "https://github.com/jwiegley/emacs-async.git")
   (version . "v1.9.9") (update . stable)
   (requirements (emacs "24.4")))
  ("compat" (method . git)
   (remote . "https://github.com/emacs-compat/compat.git")
   (version . "30.1.0.0") (update . stable)
   (requirements (emacs "24.4") (seq "2.23")))
  ("cond-let" (method . git)
   (remote . "https://github.com/tarsius/cond-let")
   (version . "v0.2.2") (update . stable)
   (requirements (emacs "28.1")))
  ("dash" (method . git)
   (remote . "https://github.com/magnars/dash.el.git")
   (version . "2.20.0") (update . stable) (requirements (emacs "24")))
  ("f" (method . git) (remote . "https://github.com/rejeep/f.el.git")
   (version . "v0.21.0") (update . stable)
   (requirements (emacs "24.1") (s "1.7.0") (dash "2.2.0")))
  ("llama" (method . git)
   (remote . "https://github.com/tarsius/llama") (version . "v1.0.0")
   (update . stable) (requirements (emacs "26.1") (compat "30.1")))
  ("noflet" (method . git)
   (remote . "https://github.com/nicferrier/emacs-noflet.git")
   (version . "7ae84dc3257637af7334101456dafe1759c6b68a")
   (update . unstable) (branch . "master"))
  ("queue" (method . elpa)
   (remote . "https://elpa.gnu.org/packages/queue.html")
   (last-remote . "https://elpa.gnu.org/packages/queue.html")
   (version . "0.2"))
  ("rem" (method . git) (remote . "https://github.com/djr7C4/rem.git")
   (version . "v0.10.0") (update . stable)
   (requirements (emacs "29") (f "0.21.0") (llama "1.0.0")
		 (noflet "0.0.15") (transient "0.12.0")))
  ("s" (method . git) (remote . "https://github.com/magnars/s.el.git")
   (version . "1.13.0") (update . stable))
  ("subtree-package" (method . git)
   (remote . "https://github.com/djr7C4/subtree-package.git")
   (version . "v0.13.1") (update . stable)
   (requirements (anaphora "1.0.4") (async "1.9.9") (dash "2.20.0")
		 (emacs "29.1") (f "0.21.0") (queue "0.2")
		 (rem "0.10.0") (s "1.13.0") (transient "0.12.0")))
  ("transient" (method . git)
   (remote . "https://github.com/magit/transient.git")
   (version . "v0.12.0") (update . stable)
   (requirements (emacs "28.1") (compat "30.1") (cond-let "0.2")
		 (seq "2.24")))))
